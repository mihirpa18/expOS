alias functionNum R1;
alias currentPID R2;
//breakpoint;

//-----------------------------------------------------------------------------------------------------------------------------

//aquire disk
if(functionNum==3) then
    //breakpoint;
    
    //WAIT IN LOOP UNTIL disk IS FREE
    while([DISK_STATUS_TABLE+0]==1) do
        //state ->wait disk
        [PROCESS_TABLE + (currentPID*16) +4]=WAIT_DISK;

        //context switch
        multipush(R1,R2);
        call SCHEDULER;
        multipop(R1,R2);

    endwhile;

    [DISK_STATUS_TABLE+0]=1;
    [DISK_STATUS_TABLE+4]=currentPID;

    return;

endif;

//-----------------------------------------------------------------------------------------------------------------

//aquire terminal
if(functionNum==8) then
    //WAIT IN LOOP UNTIL TERMINAL IS FREE
    while([TERMINAL_STATUS_TABLE]==1) do
        [PROCESS_TABLE+(currentPID*16)+4]=WAIT_TERMINAL;  //CHANGE STATE
        multipush(R1,R2);

        call SCHEDULER;

        multipop(R1,R2);  //this will be only executed after scheduler schedules the process again

    endwhile;

    [TERMINAL_STATUS_TABLE]=1;
    [TERMINAL_STATUS_TABLE+1]=currentPID;

    
    return;
endif;

//---------------------------------------------------------------------------------------------------------------

//release terminal
if(functionNum==9) then

    //currentPID and PID stored in the Terminal Status table should be same
    if([TERMINAL_STATUS_TABLE+1]!=currentPID) then
        R0=-1;
        return;
    endif;

    [TERMINAL_STATUS_TABLE]=0;

    //change status of all waiting process
    alias i R3;
    i=1;
    while(i<MAX_PROC_NUM) do
        if([PROCESS_TABLE+(i*16)+4]==WAIT_TERMINAL) then
            [PROCESS_TABLE+(i*16)+4]=READY;
        endif;
        i=i+1;
    endwhile;

    R0=0;
    return;
endif;