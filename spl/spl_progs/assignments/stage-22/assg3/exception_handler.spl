//number of kernal switches
[SYSTEM_STATUS_TABLE + 27] = [SYSTEM_STATUS_TABLE + 27] + 1;

breakpoint;

[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE+1]*16) +9]=-1;
[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE+1]*16) +13]=SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +11]*512-1;

backup;

//push EIP
multipush(EIP);

//if exception cause is not page fault or user stack is full -> exit 
if(EC!=0 || [PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE+1]*16) +13]>=(PTLR*512-1)) then
    //breakpoint;
    if([PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE+1]*16) +13]>=(PTLR*512-1)) then
        print "StackOverflow";
    else
        if(EC==1) then
            print "ill_Inst";
        endif;
        if(EC==2) then
            print "ill_mem_add";
        endif;
        if(EC==3) then
            print "ill_math";
        endif;
    endif;

    //call exit process and schedule other process
    multipush(R1);
    R1=3;
    R2=[SYSTEM_STATUS_TABLE+1];
    call PROCESS_MANAGER;
    multipop(R1);

    call SCHEDULER;
endif;

//IF PAGE FAULT IS DUE TO CODE PAGE 
if(EPN>3 && EPN<8) then

    alias reqBlock R2;
    alias pageNum R3;
    reqBlock=[DISK_MAP_TABLE+ ([SYSTEM_STATUS_TABLE+1]*10) +EPN];

    breakpoint;

    //call get code page
    multipush(EPN,R1,R2);
    R2=reqBlock;
    R1=5;
    call MEMORY_MANAGER;
    multipop(EPN,R1,R2);

    pageNum=R0;

    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + EPN*2]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + (EPN*2)+1]="1100";

endif;

//if exception is due to heap page
if(EPN==2 || EPN==3) then
    //allocate 2 heap pages 
    multipush(R1);
    R1=1;
    call MEMORY_MANAGER;
    multipop(R1);
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + 4]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + 5]="1110";

    multipush(R1);
    R1=1;
    call MEMORY_MANAGER;
    multipop(R1);
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + 6]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + 7]="1110";

endif;

[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE+1]*16) +9]=0;

multipop(EIP);
restore;

SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16 ) + 13];
SP=SP+1;
alias page R2;
page=[[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) +14] + (SP/512)*2];
[(page*512) + (SP%512)]=EIP;

ireturn;
