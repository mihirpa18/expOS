alias userSP R0;
userSP = SP;

breakpoint;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13] = SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1 ] * 16 ) + 11] * 512 - 1;

//extract sys call number
alias syscall R1;
syscall=[[PTBR + ((userSP - 5) / 512) * 2] * 512 + (userSP - 5) % 512];

//wait sys call
if(syscall == INT_WAIT) then
    breakpoint;
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=13;
    alias waitPID R2;
    waitPID = [[PTBR + ((userSP - 4) / 512) * 2] * 512 + (userSP - 4) % 512];

    alias currPID R3;
    currPID=[SYSTEM_STATUS_TABLE + 1];

    if((currPID == waitPID) || ([PROCESS_TABLE + (waitPID * 16) + 4] == TERMINATED) || (waitPID>=16 || waitPID<0)) then
        [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = -1;
    else
        [PROCESS_TABLE + (currPID*16) + 4] = WAIT_PROCESS;
        [PROCESS_TABLE + (currPID*16) + 5] = waitPID;

        multipush(R0,R1,R2,R3);
        call SCHEDULER;
        multipop(R0,R1,R2,R3);

        [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = 0;  //return 0
    endif;

    [PROCESS_TABLE + currPID*16 + 9]=0;  //reset ,modeflag
endif;

//signal sys call
if(syscall == INT_SIGNAL) then
    breakpoint;
    print "sig";
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=14; //mode flag

    alias i R2;
    i=0;
    while(i<MAX_PROC_NUM) do
        if(([PROCESS_TABLE + (i*16) +4] == WAIT_PROCESS) && [PROCESS_TABLE + (i*16) +5] == [SYSTEM_STATUS_TABLE+1]) then
            [PROCESS_TABLE + (i*16) +4] = READY;
        endif;
        i=i+1;
    endwhile;

    [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = 0;  //return 0
    [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9]=0;
endif;

//get pid
if(syscall == INT_GETPID) then
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=11;
    [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = [SYSTEM_STATUS_TABLE+1];
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=0;
endif;

//get parent pid
if(syscall == INT_GETPPID) then
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=12;
    [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 2];
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] *16) + 9]=0; 
endif;

SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13];
ireturn;
