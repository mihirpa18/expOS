//*arg -> file Descriptor and word to be written
//*return values -> 
//  0	Success
// -1	File Descriptor given is invalid
// -2	No disk space / File Full
// -3	Permission denied

alias userSP R1;
userSP = SP;

alias pid R2;
pid = [SYSTEM_STATUS_TABLE + 1];

alias retAddr R3;
retAddr = [PTBR + 2*((userSP - 1)/512)] * 512 + (userSP - 1) % 512;

alias mode R4;
mode = PROCESS_TABLE + (pid*16) + 9;

[mode] = INT_WRITE;   //SET MODE FLAG TO SYS CALL NUM - 7


//CHANGE FROM USER STACK TO KERNAL STACK
[PROCESS_TABLE+(pid*16)+13]=SP;
SP=[PROCESS_TABLE+(pid*16)+11]*512-1;   

alias fileDescriptor R5;
fileDescriptor = [PTBR + 2*((userSP - 4)/512)] * 512 + (userSP - 4) % 512;

alias wordAddr R6;
wordAddr = [PTBR + 2*((userSP - 3)/512)] * 512 + (userSP - 3) % 512;

if([fileDescriptor] == -2) then        //if terminal write
    //terminal write
    multipush(R1,R2,R3,R4,R5,R6);
    R1 = TERMINAL_WRITE;  //
    R2 = pid;
    R3 = [wordAddr];
    call DEVICE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6);

    [retAddr] = 0;
else
    if([fileDescriptor]<0 || [fileDescriptor]>7) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias resource_table R7;
    resource_table = [PROCESS_TABLE + (pid*16) + 11]*512 + RESOURCE_TABLE_OFFSET;

    //If the Resource identifier field of the Per Process Resource Table entry is invalid or does not indicate a FILE, return -1.  
    if([resource_table + [fileDescriptor]*2] != FILE) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias openFileInd R8;
    openFileInd = [resource_table + [fileDescriptor]*2 + 1];
    alias inodeInd R9;
    inodeInd = [OPEN_FILE_TABLE + openFileInd*4];

    //if current user is not root and owner of the file , return -3 -> permission denied
    if(([PROCESS_TABLE + pid*16 + 3] != 1) && ([INODE_TABLE + inodeInd*16 + 3] != [PROCESS_TABLE + pid*16 + 3])) then
        [retAddr] = -3;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    //aquire lock
    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
    R1 = ACQUIRE_INODE;
    R2 = inodeInd;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);

    //if lock fails
    if(R0 == -1) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    //Get the Lseek position from the Open File Table entry.
    alias lseek R10;
    lseek = OPEN_FILE_TABLE + openFileInd*4 + 2;

    if([lseek] == MAX_FILE_SIZE) then
        multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
        R1 = RELEASE_INODE;
        R2 = inodeInd;
        R3 = pid;
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);

        [retAddr] = -2;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;
    
    //if lseek value is multiple of 512 and same as file size in inode table
    if([lseek]%512 == 0 && [INODE_TABLE + inodeInd*16 + 2] == [lseek]) then
        multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
        R1 = GET_FREE_BLOCK;
        call MEMORY_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);

        if(R0 == -1) then
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
            R1 = RELEASE_INODE;
            R2 = inodeInd;
            R3 = pid;
            call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);

            [retAddr] = -2;
            [mode] = 0;
            SP = userSP;
            ireturn;
        else
            [INODE_TABLE + inodeInd*16 + 8 + ([lseek]/512)] = R0;
        endif;
    endif;

    alias blockNum R11;
    blockNum = [INODE_TABLE + inodeInd*16 + 8 + ([lseek]/512)];

    alias blockOffset R12;
    blockOffset = [lseek]%512;

    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);
    R1 = BUFFERED_WRITE;
    R2 = blockNum;
    R3 = blockOffset;
    R4 = [wordAddr];
    call FILE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);

    //if lseek = file size -> increment file size in inode table and mem copy of root file
    if([lseek] == [INODE_TABLE + inodeInd*16 + 2]) then
        [INODE_TABLE + inodeInd*16 + 2] = [INODE_TABLE + inodeInd*16 + 2] + 1;
        [ROOT_FILE + inodeInd*8 + 1] = [ROOT_FILE + inodeInd*8 + 1] + 1;
    endif;

    [lseek] = [lseek] + 1;

    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);
    R1 = RELEASE_INODE;
    R2 = inodeInd;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);

    [retAddr] = 0;
endif;

[mode] = 0;
SP=userSP;
ireturn;