alias funNum R1;

breakpoint;

//FREE userArea page
if(funNum==2) then
    alias currPID R2;

    alias userAreaPage R3;
    userAreaPage=[PROCESS_TABLE+(currPID*16) +11];

    //print userAreaPage;

    //free user area page
    multipush(R1,R2,R3);
    R1=2;
    R2=userAreaPage;
    call MEMORY_MANAGER;
    multipop(R1,R2,R3);

    return;
endif;

//EXIT PROCESS
if(funNum==3) then 
    alias currPID R2;

    //print "exit function";

    multipush(R1,R2);
    //invoke free page table 
    R1=4;
    R2=currPID;
    call PROCESS_MANAGER;
    multipop(R1,R2);

    //print "freePage";
    //breakpoint;

    multipush(R1,R2);
    //invoke free userAreaPage
    R1=2;
    R2=currPID;
    call PROCESS_MANAGER;
    multipop(R1,R2);

    // breakpoint;
    //print "userarea";

    //set state as terminated for the process
    [PROCESS_TABLE + (currPID*16) +4]=TERMINATED;

    return;
endif;

//FREE_PAGE_TABLE
if(funNum == 4) then
    alias currPID R2;
    
    //print "in";

    //INVALIDATE LIBRARY entries
    [PTBR+0]=-1;
    [PTBR+1]="0000";
    [PTBR+2]=-1;
    [PTBR+3]="0000";

    //for each valid page , release page using release page in MEMORY_MANAGER
    alias i R3;
    i=4;
    while(i<20) do
        if([PTBR + i]!=-1) then

            //call release page
            multipush(R1,R2,R3);
            R1=2;
            R2=[PTBR+i];
            call MEMORY_MANAGER;
            multipop(R1,R2,R3);

            //invalidate entry
            [PTBR+i]=-1;
            [PTBR+(i+1)]="0000";
        endif;
        i=i+2;
    endwhile;

    //breakpoint;
    //print "4 done";

    return ;
endif;
