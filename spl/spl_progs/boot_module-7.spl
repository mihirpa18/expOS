//INIT
loadi(65,7);
loadi(66,8);

//inode table
loadi(59,3);
loadi(60,4);

//----------------------------------------------------------------------------------------

//INT 7 modules
loadi(16,29);
loadi(17,30);

//INT 10 modules
loadi(22,35);
loadi(23,36);

//int 6
loadi(14,27);
loadi(15,28);

//int 9
loadi(20,33);
loadi(21,34);

//--------------------------------------------------------------------------------------------

//exception handlers
loadi(2, 15);
loadi(3, 16);
loadi(63,13);
loadi(64,14);

//timer interrupts
loadi(4,17);
loadi(5,18);

//console interrupts
loadi(8,21);
loadi(9,22);

//DISK interrupts
loadi(6,19);
loadi(7,20);

//------------------------------------------------------------------------------------------------

//load module 0 -resource manager module
loadi(40,53);
loadi(41,54);

//load module 1 - process manager
loadi(42,55);
loadi(43,56);

//load module 2 - memory manager
loadi(44,57);
loadi(45,58);

//load module 4 -device manager module
loadi(48,61);
loadi(49,62);

//load module 5-scheduler module
loadi(50,63);
loadi(51,64);

//------------------------------------------------------------------------------



//-----------------------------------------------------------------

[TERMINAL_STATUS_TABLE]=0;          //terminal status table

//system status table
[SYSTEM_STATUS_TABLE+2]=NUM_MEM_PAGES-82;
[SYSTEM_STATUS_TABLE+3]=0;

//disk status table
[DISK_STATUS_TABLE+0]=0;

//---------------------------------------------------------------------------

//initialize MEMORY_FREE_LIST
alias i R0;
i=0;

while(i<=82) do
    [MEMORY_FREE_LIST+i]=1;
    i=i+1;
endwhile;

while(i<NUM_MEM_PAGES) do
    [MEMORY_FREE_LIST+i]=0;
    i=i+1;
endwhile;

//--------------------------------------------------------------------------------

//page table entries for init
PTBR=PAGE_TABLE_BASE+20;
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

//PROCESS TABLE FOR INIT
[PROCESS_TABLE+16+11]=80; //user area 
[PROCESS_TABLE+16+1]=1; //pid
[PROCESS_TABLE+16+4]=CREATED; //STATE
[PROCESS_TABLE+16+13]=8*512;
[PROCESS_TABLE+16+12]=0;
[PROCESS_TABLE+16+14]=PTBR;
[PROCESS_TABLE+16+15]=PTLR;

//second entry of the header of an executable file will contain an entry point value for init
[76*512] = [65*512+1];

//per process resource table for init 
alias resource_table R1;
resource_table=80*512+RESOURCE_TABLE_OFFSET;
i=0;
while(i<16) do
    [resource_table+i]=-1;
    i=i+1;
endwhile;

//----------------------------------------------------------------------------------------------------

//set all remaining process state to terminated
i=2;
while(i<MAX_PROC_NUM) do
    [PROCESS_TABLE+(i*16)+4]=TERMINATED;
    i=i+1;
endwhile;


return;