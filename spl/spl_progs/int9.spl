//SAVE USERSP AND CHANGE TO KERNAL STACK

breakpoint;

alias userSP R0;
userSP=SP;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 13] = SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 11] * 512 - 1;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] *16) + 9]=9;  //SET MODE FLAG TO 9 -> exec ->sys call num 9

//get name of file using user stack
alias fileNamePage R1;
alias fileNameAddr R2;
fileNamePage=[PTBR + 2*((userSP-4)/512)];
fileNameAddr=fileNamePage*512 + (userSP-4)%512;

alias fileName R3;
fileName=[fileNameAddr];


//validate inode table and xexe format
alias inodeInd R4;
inodeInd=0;
while(inodeInd<MAX_FILE_NUM) do
    if([INODE_TABLE + (inodeInd*16) + 1] == fileName) then
        break;
    else
        inodeInd=inodeInd+1;
    endif;
endwhile;

//if file format is not xexe or no such file is found return 
if(inodeInd==MAX_FILE_NUM || ([INODE_TABLE + (inodeInd*16) + 0]!=EXEC)) then
    print "invalid file";
    alias retAddr R5;
    retAddr=[PTBR + 2*((userSP-1)/512)]*512 + ((userSP-1)%512);
    [retAddr]=-1;     //return -1
    SP=userSP;
    ireturn;
endif;

//calling exit function in process manager module to deallocate resources and pages of current process
multipush(R0,R1,R2,R3,R4);      //STORE regs
R1=3;                           //FUNCTION NUM IS 3 FOR EXIT PROCESS
R2=[SYSTEM_STATUS_TABLE+1];     //CURR PID

call PROCESS_MANAGER;           //mod 1 -> process manager module

//print "processOk";

multipop(R0,R1,R2,R3,R4);       //RESTORE 

alias userAreaPage R5;
userAreaPage=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 11];

//increment mem free list of the userarea page as it is reclaims the same user area page  for new process
[MEMORY_FREE_LIST + userAreaPage]=[MEMORY_FREE_LIST + userAreaPage]+1;
//decrement mem free count field in system status table
[SYSTEM_STATUS_TABLE + 2]=[SYSTEM_STATUS_TABLE + 2]-1;

SP=userAreaPage*512-1;

//Update the STATE field to RUNNING 
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 4]=RUNNING;
//store inode index obtained above in the inode index field in the process table.
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 7]=inodeInd;

//-----------------------------------------------------------------------------------------------------------

//Allocate new pages and set the page table entries for the new process
PTBR=PAGE_TABLE_BASE + [SYSTEM_STATUS_TABLE+1] * 20;

//SET Library CODE
[PTBR+0]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";
 
//---------------------------------------------------------------------------------------------------------------

//Allocate 2 HEAP AND 2 STACK
multipush(R0,R1,R2,R3,R4,R5);

//HEAP
R1=1;  //GET FREE PAGE FUNC NUM  AND IT NEED NO ARGS SO...
call MEMORY_MANAGER;

[PTBR+4]=R0;
[PTBR+5]="0110";

R1=1;
call MEMORY_MANAGER;

[PTBR+6]=R0;
[PTBR+7]="0110";

//----------------------------------------------------------------------------------------------------
//STACK

R1=1;  
call MEMORY_MANAGER;

[PTBR+16]=R0;
[PTBR+17]="0110";

R1=1;
call MEMORY_MANAGER;

[PTBR+18]=R0;
[PTBR+19]="0110";

multipop(R0,R1,R2,R3,R4,R5);

//----------------------------------------------------
//CODE

//find out number of pages required to be allocated
multipush(R0,R1,R2,R3,R4,R5);

if([INODE_TABLE + (inodeInd*16) + 8]!=-1) then
    R1=1;
    call MEMORY_MANAGER;
    loadi(R0,[INODE_TABLE + (inodeInd*16) + 8]);
    [PTBR+ 8]=R0;
    [PTBR+ 9]="0100";
else    
    [PTBR+ 8]=-1;
    [PTBR+ 9]="0000";
endif;
if([INODE_TABLE + (inodeInd*16) + 9]!=-1) then
    R1=1;
    call MEMORY_MANAGER;
    loadi(R0,[INODE_TABLE + (inodeInd*16) + 9]);
    [PTBR+ 10]=R0;
    [PTBR+ 11]="0100";
else    
    [PTBR+ 10]=-1;
    [PTBR+ 11]="0000";
endif;
if([INODE_TABLE + (inodeInd*16) + 10]!=-1) then
    R1=1;
    call MEMORY_MANAGER;
    loadi(R0,[INODE_TABLE + (inodeInd*16) + 10]);
    [PTBR+ 12]=R0;
    [PTBR+ 13]="0100";
else    
    [PTBR+ 12]=-1;
    [PTBR+ 13]="0000";
endif;
if([INODE_TABLE + (inodeInd*16) + 11]!=-1) then
    R1=1;
    call MEMORY_MANAGER;
    loadi(R0,[INODE_TABLE + (inodeInd*16) + 11]);
    [PTBR+ 14]=R0;
    [PTBR+ 15]="0100";
else    
    [PTBR+ 14]=-1;
    [PTBR+ 15]="0000";
endif;

multipop(R0,R1,R2,R3,R4,R5);

//Store the entry point IP (present in the header of first code page) value on top of the user stack.
[[PTBR+16]*512]=[[PTBR+8]*512+1];

//change to user stack
SP=8*512;
[PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+9]=0;

breakpoint;

ireturn;