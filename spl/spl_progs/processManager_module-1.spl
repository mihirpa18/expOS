alias funNum R1;

//breakpoint;

//get pcb entry
if(funNum==1) then
    //breakpoint;
    alias i R2;
    i=0;
    while(i<MAX_PROC_NUM) do
        if([PROCESS_TABLE + (i*16) + 4]==TERMINATED) then
            R0=i;
            [PROCESS_TABLE + (i*16) +4]=ALLOCATED;
            [PROCESS_TABLE + (i*16) +1]=i;
            [PROCESS_TABLE + (i*16) +14]=PAGE_TABLE_BASE+(i*20);
            [PROCESS_TABLE + (i*16) +15]=10;
            break;
        endif;
        i=i+1;
    endwhile;

    if(i==MAX_PROC_NUM) then
        R0=-1;
    endif;

    return;
endif;

//FREE userArea page
if(funNum==2) then
    alias currPID R2;

    alias userAreaPage R3;
    userAreaPage=[PROCESS_TABLE+(currPID*16) +11];

    //print userAreaPage;

    //free user area page
    multipush(R1,R2,R3);
    R1=2;
    R2=userAreaPage;
    call MEMORY_MANAGER;
    multipop(R1,R2,R3);

    return;
endif;

//EXIT PROCESS
if(funNum==3) then 
    alias currPID R2;

    //print "exit function";

    multipush(R1,R2);
    //invoke free page table 
    R1=4;
    R2=currPID;
    call PROCESS_MANAGER;
    multipop(R1,R2);

    //print "freePage";
    //breakpoint;

    multipush(R1,R2);
    //invoke free userAreaPage
    R1=2;
    R2=currPID;
    call PROCESS_MANAGER;
    multipop(R1,R2);

    // breakpoint;
    //print "userarea";

    //set state as terminated for the process
    [PROCESS_TABLE + (currPID*16) +4]=TERMINATED;

    return;
endif;

//FREE_PAGE_TABLE
if(funNum == 4) then
    alias currPID R2;
    
    //print "in";

    //INVALIDATE LIBRARY entries
    [PTBR+0]=-1;
    [PTBR+1]="0000";
    [PTBR+2]=-1;
    [PTBR+3]="0000";

    //for each valid page , release page using release page in MEMORY_MANAGER
    alias i R3;
    i=4;
    while(i<20) do
        if([PTBR + i]!=-1) then

            //call release page
            multipush(R1,R2,R3);
            R1=2;
            R2=[PTBR+i];
            call MEMORY_MANAGER;
            multipop(R1,R2,R3);

            //invalidate entry
            [PTBR+i]=-1;
            [PTBR+(i+1)]="0000";
        endif;
        i=i+2;
    endwhile;

    //invalidate disk map table 
    //if there is any heap or stack valid page then call release disk 
    //heap
    i=2;
    while(i<4) do  
        alias block R4;
        block=[DISK_MAP_TABLE+(currPID*10)+i]; 
        if(block!=-1) then
            multipush(R1,R2,R3,R4);
            R1=4;
            R3=currPID;
            R2=block;
            call MEMORY_MANAGER;
            multipop(R1,R2,R3,R4);
        endif;
        i=i+1;
    endwhile;
    //stack
    i=8;
    while(i<10) do  
        alias block R4;
        block=[DISK_MAP_TABLE+(currPID*10)+i]; 
        if(block!=-1) then
            multipush(R1,R2,R3,R4);
            R1=4;
            R3=currPID;
            R2=block;
            call MEMORY_MANAGER;
            multipop(R1,R2,R3,R4);
        endif;
        i=i+1;
    endwhile;

    //invalidate disk map table
    i=0;
    while(i<10) do
        [DISK_MAP_TABLE+(currPID*10)+i]=-1;
        i=i+1;
    endwhile;

    //breakpoint;
    //print "4 done";

    return ;
endif;
