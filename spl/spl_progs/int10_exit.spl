alias currPID R0;
currPID=[SYSTEM_STATUS_TABLE+1];

[PROCESS_TABLE+(currPID*16)+4]=TERMINATED;

alias flag R2;
flag=0;
alias i R3;
i=1;

while(i<MAX_PROC_NUM) do
    if([PROCESS_TABLE+(i*16)+4]!=TERMINATED) then
        flag=1;
        break;
    endif;
    i=i+1;
endwhile;

if(flag==0) then
    halt;
else
    call SCHEDULER;
endif;