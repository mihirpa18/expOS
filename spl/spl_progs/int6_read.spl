alias userSP R1;
userSP = SP;

alias pid R2;
pid = [SYSTEM_STATUS_TABLE + 1];

alias retAddr R3;
retAddr = [PTBR + 2*((userSP - 1)/512)] * 512 + (userSP - 1) % 512;

alias mode R4;
mode = PROCESS_TABLE + (pid*16) + 9;

[mode] = INT_READ;   //SET MODE FLAG TO SYS CALL NUM - 7

//CHANGE FROM USER STACK TO KERNAL STACK
[PROCESS_TABLE+(pid*16)+13]=SP;
SP=[PROCESS_TABLE+(pid*16)+11]*512-1;   

alias fileDescriptor R5;
fileDescriptor = [PTBR + 2*((userSP - 4)/512)] * 512 + (userSP - 4) % 512;

alias wordAddr R6;
wordAddr = [PTBR + 2*((userSP - 3)/512)] * 512 + (userSP - 3) % 512;

//if input is read terminal (fd = -1) then call terminal read from device manager 
if([fileDescriptor] == -1) then
    multipush(R1,R2,R3,R4,R5,R6);
    R1 = TERMINAL_READ;  //FUNCTION NUM OF TERMINAL READ = 4
    R2 = pid;
    R3 = [wordAddr];
    call DEVICE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6);

    [retAddr] = 0;
else

    //if fileDescriptor is invalid return -1
    if([fileDescriptor]<0 || [fileDescriptor]>7) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias resource_table R7;
    resource_table = [PROCESS_TABLE + (pid*16) + 11]*512 + RESOURCE_TABLE_OFFSET;

    //If the Resource identifier field of the Per Process Resource Table entry is invalid or does not indicate a FILE, return -1.  
    if([resource_table + [fileDescriptor]*2] != FILE) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias openFileInd R8;
    openFileInd = [resource_table + [fileDescriptor]*2 + 1];
    alias inodeInd R9;
    inodeInd = [OPEN_FILE_TABLE + openFileInd*4];

    //ACQUIRE LOCK
    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
    R1 = ACQUIRE_INODE;
    R2 = inodeInd;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);

    //if lock fails
    if(R0 == -1) then
        [retAddr] = -1;
        [mode] = 0;
        SP = userSP;
        ireturn;
    endif;

    alias lseek R10;
    lseek = OPEN_FILE_TABLE + openFileInd*4 + 2;

    alias phyWordAddr R11;
    phyWordAddr = [PTBR + 2*([wordAddr]/512)] * 512 + ([wordAddr]%512);

    if([OPEN_FILE_TABLE + (openFileInd*4) + 0] == INODE_ROOT) then
        //if file pointer reached end of file
        if([lseek] == 480) then
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);
            R1 = RELEASE_INODE;
            R2 = inodeInd;
            R3 = pid;
            call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);

            [retAddr] = -2;   //File pointer has reached the end of file 
            [mode] = 0;
            SP = userSP;
            ireturn;
        endif;

        //Read from the word at lseek position in memory copy of root file to the translated memory address
        [phyWordAddr] = [ROOT_FILE + [lseek]];
        [lseek] = [lseek] + 1;

        [retAddr] = 0;
    else
        //end of file
        if([lseek] == [INODE_TABLE + inodeInd*16 + 2]) then
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);
            R1 = RELEASE_INODE;
            R2 = inodeInd;
            R3 = pid;
            call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);

            [retAddr] = -2;   //File pointer has reached the end of file 
            [mode] = 0;
            SP = userSP;
            ireturn;
        endif;

        alias blockNum R12;
        blockNum = [INODE_TABLE + inodeInd*16 + 8 + ([lseek]/512)];

        alias blockOffset R13;
        blockOffset = [lseek]%512;


        multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12,R13);
        R1 = BUFFERED_READ;  //2
        R2 = blockNum;
        R3 = blockOffset;
        R4 = phyWordAddr;
        call FILE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12,R13);


        [lseek] = [lseek] + 1;

        [retAddr] = 0;
    endif;

    //RELEASE LOCK
    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);
    R1 = RELEASE_INODE;
    R2 = inodeInd;
    R3 = pid;
    call RESOURCE_MANAGER;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11);

endif;

[mode]=0;  //RESET MODE FLAG
SP=userSP;
ireturn;