int main(){
    decl 
        int fd,temp;
        string fileName,Rword,word;
    enddecl

    begin
        fileName = "one.dat";

        fd = exposcall("Open",fileName);

        if(fd < 0) then
            temp = exposcall("Write",-2,"error");
        else
            temp = exposcall("Read",-1,Rword);
            temp = exposcall("Write",fd,Rword);
            temp = exposcall("Read",-1,Rword);
            temp = exposcall("Write",fd,Rword);

            while(1 == 1) do
                temp = exposcall("Seek",fd,-1);
                if(temp == -2) then
                    break;
                endif;

                temp = exposcall("Read",fd,word);
                if(temp == -2) then
                    break;
                endif;
                temp = exposcall("Write", -2, word);
                temp = exposcall("Seek",fd,-1);
            endwhile;
            
        endif;
        return 0;
    end
}