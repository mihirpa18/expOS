type
        Student{
                str name;
                int marks;
        }
endtype

int main(){

decl
	Student temp;
	Student s1;
enddecl

begin
	temp=initialize();
	s1=alloc();
	s1.name="Mihir";
	s1.marks=89;
	breakpoint;
	temp=exposcall("Write",-2,s1.name);
	temp=exposcall("Write",-2,s1.marks);

	return 0;

end
}

