//number of kernal switches
[SYSTEM_STATUS_TABLE + 27] = [SYSTEM_STATUS_TABLE + 27] + 1;

alias userSP R0;
userSP = SP;

breakpoint;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13] = SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1 ] * 16 ) + 11] * 512 - 1;

//extract sys call number
alias syscall R1;
syscall=[[PTBR + ((userSP - 5) / 512) * 2] * 512 + (userSP - 5) % 512];

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 9] = syscall;    //mode flag

//semget
if(syscall == INT_SEMGET) then
    breakpoint;
    alias i R2;
    i=0;

    //Find the index of a free entry in the Per Process Resource Table.
    alias resource_table R3;
    resource_table=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 11]*512 + RESOURCE_TABLE_OFFSET;
    alias semId R4;
    semId=-1;
    while(i<8) do
        if([resource_table + i*2] == -1) then
            semId=i;       //since we need index
            break;
        endif;
        i=i+1;
    endwhile;

    //if no free entry then  return -1
    if(semId == -1) then
        [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = -1;
    else
        alias semIndex R5;
        //acquire semaphore -> resource manager    
        multipush(R0,R1,R2,R3,R4);
        R1=ACQUIRE_SEMAPHORE;   //6
        R2=[SYSTEM_STATUS_TABLE+1];
        call RESOURCE_MANAGER;
        semIndex=R0;
        multipop(R0,R1,R2,R3,R4);

        //if Number of semaphores has reached its maximum -> no semaphores left
        if(semIndex == -1) then 
            [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = -2;
        else
            [resource_table + 2*semId] = SEMAPHORE;   //set resource id
            [resource_table + 2*semId + 1] = semIndex;
            [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = semId;
        endif;
    endif;    
endif;

//sem release
if(syscall == INT_SEMRELEASE) then
    //sem descriptor is passed as argument 
    breakpoint;
    alias semId R2;
    semId = [[PTBR + ((userSP - 4) / 512) * 2] * 512 + (userSP - 4) % 512];

    alias resource_table R3;
    resource_table=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1]*16) + 11]*512 + RESOURCE_TABLE_OFFSET;

    if(semId<0 || semId>7 || [resource_table + 2*semId] != SEMAPHORE) then
        [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = -1;
    else
        //call release semaphore
        multipush(R0,R1,R2,R3);
        R1 = RELEASE_SEMAPHORE;
        R2 = [resource_table + 2*semId + 1];  //semaphore table index
        R3 = [SYSTEM_STATUS_TABLE+1];
        call RESOURCE_MANAGER;
        multipop(R0,R1,R2,R3);

        //invalidate resource table
        [resource_table + 2*semId]=-1;
        [resource_table + 2*semId + 1]=-1;

        [[PTBR + ((userSP - 1) / 512) * 2] * 512 + (userSP - 1) % 512] = 0;
    endif;
endif;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE+1]*16 + 9]=0;    
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13];
ireturn;