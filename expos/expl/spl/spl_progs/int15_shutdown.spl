[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13] = SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1 ] * 16 ) + 11] * 512 - 1;

[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 9] = INT_SHUTDOWN;

//Shutdown system call can be invoked only from the shell process of the root user -> SHOULD BE SHELL PROCESS or ROOT
if(([PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1]*16) + 1] != SHELL_PROCESS) || ([PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1]*16) + 3] != ROOT)) then
    [[PTBR + 2*(([PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13] - 1)/512)] * 512 + ([PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13] - 1) % 512] = -1;
    [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 9] = 0;
    SP = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE+1] * 16 ) + 13];
    ireturn;
else

    //kill all -> 5
    R1 = KILL_ALL;
    R2 = [SYSTEM_STATUS_TABLE + 1];
    call PROCESS_MANAGER;

    alias i R1;
    i=0;
    while(i<4) do
        if([BUFFER_TABLE + i*4 + 1] == 1) then
            multipush(R1);
            R3 = BUFFER_BASE + i;
            R4 = [BUFFER_TABLE + i*4];
            R1 = DISK_STORE;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            call DEVICE_MANAGER;
            multipop(R1);
        endif;
        i = i+1;
    endwhile; 
    
    //STORE CHANGES OF INODE TABLE -> page num= 59,60 and blocks =3,4
    R1 = DISK_STORE; //1
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = 59;    
    R4 = 3; 
    call DEVICE_MANAGER;
    R1 = DISK_STORE; //1
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = 60;    
    R4 = 4; 
    call DEVICE_MANAGER;

    //root file -> pageNum = 62 and block = 5
    R1 = DISK_STORE; //1
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = 62;    
    R4 = 5; 
    call DEVICE_MANAGER;

    //disk free list -> pageNum = 61 and block = 2
    R1 = DISK_STORE; //1
    R2 = [SYSTEM_STATUS_TABLE + 1];
    R3 = 61;    
    R4 = 2; 
    call DEVICE_MANAGER;    
endif;

halt;
