int main(){
    decl 
        int a,b,c,temp;
    enddecl

    begin
        temp=exposcall("Read",-1,a);
        temp=exposcall("Read",-1,b);

        while(a!=0) do
            c=a;
            a=b%a;
            b=c;
        endwhile;

        temp=exposcall("Write",-2,b);

        return 0;
    end
}