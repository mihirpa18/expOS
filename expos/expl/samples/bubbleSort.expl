decl 
    int arr[100];
    int bubbleSort(int n);
enddecl

int bubbleSort(int n){
    decl
        int i,j,temp;
    enddecl

    begin
        i=0;
        while(i<(n-1)) do
            j=i+1;
            while(j<n) do
                if(arr[i]>arr[j]) then
                    temp=arr[i];
                    arr[i]=arr[j];
                    arr[j]=temp;
                endif;
                j=j+1;
            endwhile;
            i=i+1;
        endwhile;

        return 0;
    end
}

int main(){
    decl
        int i,n,temp;
    enddecl

    begin
        i=0;
        temp=exposcall("Read",-1,n);

        while(i<n) do
            temp=exposcall("Read",-1,arr[i]);
            i=i+1;
        endwhile;

        temp=bubbleSort(n);

        i=0;
        while(i<n) do
            temp=exposcall("Write",-2,arr[i]);
            i=i+1;
        endwhile;

        return 0;
    end
}
