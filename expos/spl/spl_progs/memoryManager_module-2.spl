alias funNum R1;

//breakpoint;

//GET FREE PAGE
if(funNum==1) then
    //INCREMENT WAIT MEM COUNT IN SYSTEM TABLE  
    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]+1;  //IT IS IMPORTANT TO INCREMENT IT OUTSIDE THE BUSY LOOP BCOZ-> IF A WAS WAITING AND ONE PAGE WAS FREED BUT ANOTHER PROCESS AY C TOOK THAT PAGE ,THEN IF INCREMENT WAS INSDE LOOP WHEN A GETS SCHEDULED AGAIN IT INCREMENTS IT AGAIN ->MAKING WAITING PROCESS COUNT AS 2 INSTEAD OF 1 

    //WHILE NO AVAILABE PAGES
    while([SYSTEM_STATUS_TABLE+2]==0) do 
        //STATE->WAIT MEM
        [PROCESS_TABLE+([SYSTEM_STATUS_TABLE+1]*16)+4]=WAIT_MEM;

        //SCHEDULE OTHER PROCESS
        multipush(R1,R2);
        call SCHEDULER;
        multipop(R1,R2);
    endwhile;

    //decrement wait mem count 
    [SYSTEM_STATUS_TABLE+3]=[SYSTEM_STATUS_TABLE+3]-1;
    //decrement mem free count
    [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;

    //find free page and set corresponding entry as 1
    alias i R3;
    i=76; //76 is first usable page
    while(i<NUM_MEM_PAGES && ([MEMORY_FREE_LIST+i]!=0)) do
         i=i+1;
    endwhile;

    [MEMORY_FREE_LIST+i]=1;
    R0=i;

    return;
endif;

//release page;
if(funNum==2) then
    alias pageNum R2;
    [MEMORY_FREE_LIST+pageNum]=[MEMORY_FREE_LIST+pageNum]-1;

    if([MEMORY_FREE_LIST+pageNum]==0) then
        [SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]+1;        //INCREMENT MEM_FREE_COUNT

        alias i R3;
        i=1;
        while(i<MAX_PROC_NUM) do
            if([PROCESS_TABLE + (i*16) +4]==WAIT_MEM) then
                [PROCESS_TABLE+ (i*16) +4]=READY;
            endif;
            i=i+1;
        endwhile;
    endif;

    return;
endif;

//get free block -> 3
if(funNum == GET_FREE_BLOCK) then
    //LOOP THROUGH USER BLOCK
    alias i R2;
    i = DISK_FREE_AREA;
    while(i < DISK_SWAP_AREA) do
        if([DISK_FREE_LIST + i] == 0) then
            [DISK_FREE_LIST + i] = 1;
            R0 = i;
            return;
        endif;
        i = i+1;
    endwhile;

    R0 = -1;
    return;
endif;

//release block
if(funNum==4) then
    [DISK_FREE_LIST+R2]=[DISK_FREE_LIST+R2]-1;
    return;
endif;

//get code page
if(funNum==5) then
    //breakpoint;
    
    alias blockNum R2;
    alias pid R3;
    pid=0;
    
    //CHECK IF CODE BLOCK IS ALREADY PRESENT IN MEMORY
    while(pid<16) do
        alias i R4;
        i=4;
        while(i<8) do
            if([DISK_MAP_TABLE+ (pid*10) +i]==blockNum) then
                alias pt R5;
                pt=PAGE_TABLE_BASE+(pid*20);

                alias page R6;
                page=[pt+(i*2)];

                if(page!=-1) then
                    [MEMORY_FREE_LIST+page]=[MEMORY_FREE_LIST+page]+1;  
                    R0=page;
                    return;
                endif;
            endif;
            i=i+1;
        endwhile;
        pid=pid+1;
    endwhile;

    //IF CODE PAGE IS NOT ALREADY IN MEMORY THEN CALL GET FREE PAGE AND LOAD
    if(pid==16) then
        multipush(R1,R2,R3);
        R1=1;
        call MEMORY_MANAGER;
        multipop(R1,R2,R3);
        
        multipush(R0,R1,R2,R3);
        R1=2;
        R4=blockNum;
        R2=[SYSTEM_STATUS_TABLE+1];
        R3=R0;
        call DEVICE_MANAGER;
        multipop(R0,R1,R2,R3);

    endif;

    //breakpoint;

    return;
endif;

//get swap block - 6
if(funNum == GET_SWAP_BLOCK) then
    alias i R2;
    i = DISK_SWAP_AREA;

    while(i < DISK_SIZE) do 
        if([DISK_FREE_LIST + i] == 0) then
            [DISK_FREE_LIST + i] = 1;
            R0 = i;
            return;
        endif;
        i = i + 1;
    endwhile;

    R0 = -1;
    return;
endif;

