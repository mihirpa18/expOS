//curr pid
alias currPID R0;
currPID=[SYSTEM_STATUS_TABLE + CORE*5 + 1];

//push BP to top of curr stack
multipush(BP);

[PROCESS_TABLE+(currPID*16)+12]=SP%512;
[PROCESS_TABLE+(currPID*16)+14]=PTBR;
[PROCESS_TABLE+(currPID*16)+15]=PTLR;

multipush(R0);
R1 = ACQUIRE_SCHED_LOCK; //2
call ACCESS_CONTROL;
multipop(R0);

alias i R1;
alias newPid R2;

if(CORE == PRIMARY_CORE) then
    newPid = 0;
    if([SYSTEM_STATUS_TABLE + 5] != 0) then
        if([PROCESS_TABLE + SWAPPER_DAEMON*16 + 4] == WAIT_DISK) then
            newPid = 0;
        else
            newPid = SWAPPER_DAEMON;
        endif;
    else
        //If LOGOUT_STATUS=1 and the secondary core is not running IDLE2, then schedule IDLE
        if([SYSTEM_STATUS_TABLE + 7] == 1 && [SYSTEM_STATUS_TABLE + 6] != IDLE2_PROCESS) then
            newPid = 0;    //wait for the current running process to be scheduled out of the secondary core
        else 
            i = (currPID + 1) % MAX_PROC_NUM;
            while(i != currPID) do
                if(i == IDLE_PROCESS || i == IDLE2_PROCESS || i == SWAPPER_DAEMON) then
                    i = (i + 1) % 16;
                    continue;
                endif;

                if(([PROCESS_TABLE + (i*16) + 4] == CREATED || [PROCESS_TABLE + (i*16) + 4] == READY) && [SYSTEM_STATUS_TABLE + 6] != i) then
                    if([PROCESS_TABLE + (i*16) + 6] == 0) then     //not swapped out
                        newPid=i;
                        break;
                    endif;  
                endif;

                i = (i + 1) % 16;
            endwhile;
        endif;
    endif;
else
    newPid = IDLE2_PROCESS;

    //paging is going or logout process on primary core schedule idle2
    if([SYSTEM_STATUS_TABLE + 5] != 0 || [SYSTEM_STATUS_TABLE + 7] ==1) then
        newPid = IDLE2_PROCESS;
    
    else 
        i = (currPID + 1) % 16;
        while(i != currPID) do
            if(i == IDLE_PROCESS || i == LOGIN_PROCESS || i == SHELL_PROCESS || i == IDLE2_PROCESS || i == SWAPPER_DAEMON) then
                i = (i + 1) % 16;
                continue;
            endif;

            if(([PROCESS_TABLE + (i*16) + 4] == CREATED || [PROCESS_TABLE + (i*16) + 4] == READY) && [SYSTEM_STATUS_TABLE + 1] != i) then
                if([PROCESS_TABLE + (i*16) + 6] == 0) then
                    newPid=i;
                    break;
                endif;  
            endif;

            i = (i + 1) % 16;
        endwhile;
    endif;
endif;

alias new_process_table R3;
new_process_table=PROCESS_TABLE+(newPid*16);

PTBR=[new_process_table+14];
PTLR=[new_process_table+15];

[SYSTEM_STATUS_TABLE + CORE*5 + 1]=newPid;


if([new_process_table+4]==CREATED) then
    BP=[[new_process_table+11]*512];
    [new_process_table+4]=RUNNING;
    [new_process_table+9]=0;

    multipush(R1,R2,R3);
    R1 = RELEASE_LOCK;
    R2 = SCHED_LOCK;
    call ACCESS_CONTROL; 
    multipop(R1,R2,R3);
    
    SP=[new_process_table+13];

    ireturn;
endif;

[new_process_table+4]=RUNNING;


multipush(R1,R2,R3);
R1 = RELEASE_LOCK;
R2 = SCHED_LOCK;
call ACCESS_CONTROL; 
multipop(R1,R2,R3);

SP=[(new_process_table+11)]*512+[new_process_table+12];

multipop(BP);

return;