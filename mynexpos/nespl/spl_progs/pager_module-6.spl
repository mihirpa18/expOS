alias funNum R1;
alias pid R2;

//SWAP_OUT
if(funNum == SWAP_OUT) then
    alias i R3;
    i = 3;
    alias swapProc R4;
    swapProc = -1;
    alias swapSem R5;
    swapSem = -1;
    alias swapTick R6;
    swapTick = -1;
    alias maxTick R7;
    maxTick = -1;

    //must not swap idle2
    while(i < MAX_PROC_NUM - 2) do
        alias process_table R8;
        process_table = PROCESS_TABLE + i*16;
        if([process_table + 6] == 0) then         //swap flag
            if([process_table + 4] == WAIT_PROCESS) then
                swapProc = i;
                break;
            endif;

            if(swapSem == -1 && [process_table + 4] == WAIT_SEMAPHORE) then
                swapSem = i;
            endif;

            if([process_table + 4] != TERMINATED && [process_table + 4] != RUNNING && [process_table + 4] != ALLOCATED) then
                if([process_table] > maxTick) then
                    maxTick = [process_table]; 
                    swapTick = i;
                endif;
            endif;
        endif;
        i = i+1;
    endwhile;

    if(swapProc == -1) then
        if(swapSem != -1) then
            swapProc = swapSem;
        else
            swapProc = swapTick;
        endif;
    endif;

    //If no such process exists, set the PAGING_STATUS back to 0 and return.
    if(swapProc == -1) then
        [SYSTEM_STATUS_TABLE + 5] = 0;
        return;
    endif;

    //reset TICK
    [PROCESS_TABLE + swapProc*16 ] = 0;

    alias swapPTBR R8;
    swapPTBR = PAGE_TABLE_BASE + swapProc*20;
    i = 4;
    while(i < 20) do
        alias pageNum R9;
        pageNum = [swapPTBR + i];

        if(i<=6 || i>=16) then
            if(pageNum != -1 && [MEMORY_FREE_LIST + pageNum] == 1) then
                multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
                R1 = GET_SWAP_BLOCK;
                call MEMORY_MANAGER;
                multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);

                [DISK_MAP_TABLE + swapProc*10 + i/2] = R0;

                multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
                R1 = DISK_STORE;
                R2 = pid;
                R3 = pageNum;
                R4 = R0;
                call DEVICE_MANAGER;
                multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);

            endif;
        endif;

        if(pageNum != -1) then
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
            R1 = RELEASE_PAGE;
            R2 = pageNum;
            call MEMORY_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);
        endif;

        [swapPTBR + i] = -1;
        [swapPTBR + i + 1] = "0000";

        i = i+2;
    endwhile;

    //swap flag -> 1 -> swapped out
    [PROCESS_TABLE + swapProc*16 + 6] = 1;

    //increment swap count and reset paging status to 0
    [SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] + 1;
    [SYSTEM_STATUS_TABLE + 5] = 0;

    return;
endif;

if(funNum == SWAP_IN) then
    alias i R3;
    i = 3;
    alias swapProc R4;
    swapProc = -1;
    alias maxTick R5;
    maxTick = -1;
    while(i < MAX_PROC_NUM - 1) do
        //swapped and in ready state and with highest tick val
        if([PROCESS_TABLE + i*16 + 6] == 1 && [PROCESS_TABLE + i*16 + 4] == READY) then
            if([PROCESS_TABLE + i*16] > maxTick) then
                maxTick = [PROCESS_TABLE + i*16];
                swapProc = i;
            endif;
        endif;

        i = i + 1;
    endwhile;

    if(swapProc == -1) then
        //reset PAGING_STATUS to 0;
        [SYSTEM_STATUS_TABLE + 5] = 0;
        return;
    endif;

    //reset tick
    [PROCESS_TABLE + swapProc*16] = 0;

    alias swapPTBR R6;
    swapPTBR = PAGE_TABLE_BASE + swapProc*20;
    i = 4;
    while(i < 20) do
        if(i<=6 || i>=16) then
            alias blockNum R7;
            blockNum = [DISK_MAP_TABLE + swapProc*10 + i/2];

            if(blockNum != -1) then
                multipush(R1,R2,R3,R4,R5,R6,R7);
                R1 = GET_FREE_PAGE;
                call MEMORY_MANAGER;
                multipop(R1,R2,R3,R4,R5,R6,R7);

                alias pageNum R8;
                pageNum = R0;

                multipush(R1,R2,R3,R4,R5,R6,R7,R8);
                R1 = DISK_LOAD;
                R2 = pid;
                R3 = pageNum;
                R4 = blockNum;
                call DEVICE_MANAGER;
                multipop(R1,R2,R3,R4,R5,R6,R7,R8);

                multipush(R1,R2,R3,R4,R5,R6,R7,R8);
                R1 = RELEASE_BLOCK;
                R2 = blockNum;
                R3 = pid;
                call MEMORY_MANAGER;
                multipop(R1,R2,R3,R4,R5,R6,R7,R8);

                [swapPTBR + i] = pageNum;
                [swapPTBR + i + 1] = "0110";

                [DISK_MAP_TABLE + swapProc*10 + i/2] = -1;

            endif;
        endif;

        i = i+2;
    endwhile;

    //swap flag -> 1 -> swapped out
    [PROCESS_TABLE + swapProc*16 + 6] = 0;

    //increment swap count and reset paging status to 0
    [SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] - 1;
    [SYSTEM_STATUS_TABLE + 5] = 0;

    return;
endif;