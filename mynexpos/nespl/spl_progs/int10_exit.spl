alias currPID R1;
currPID=[SYSTEM_STATUS_TABLE+1];

[PROCESS_TABLE + (currPID*16) + 9]=10;   //mode flag
[PROCESS_TABLE + (currPID*16) +13]=SP;
SP=[PROCESS_TABLE + (currPID*16) + 11]*512-1;

multipush(R1);
R1 = ACQUIRE_KERN_LOCK; //1
call ACCESS_CONTROL;
multipop(R1);

R2=currPID;
R1=3;
call PROCESS_MANAGER;

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call ACCESS_CONTROL;

call SCHEDULER;