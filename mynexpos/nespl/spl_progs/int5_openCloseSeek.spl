alias userSP R1;
userSP = SP;

alias pid R2;
pid = [SYSTEM_STATUS_TABLE + CORE*5 + 1];

alias retAddr R3;
retAddr = [PTBR + 2*((userSP - 1)/512)] * 512 + (userSP - 1) % 512;

alias syscall R4;
syscall = [[PTBR + 2*((userSP - 5)/512)] * 512 + (userSP - 5) % 512];

alias mode R5;
mode = PROCESS_TABLE + (pid*16) + 9;

//change stack and mode flag
[mode] = syscall;
[PROCESS_TABLE + (pid*16) + 13] = SP;
SP = [PROCESS_TABLE + (pid*16) + 11]*512 - 1;

multipush(R1,R2,R3,R4,R5);
R1 = ACQUIRE_KERN_LOCK; //1
call ACCESS_CONTROL;
multipop(R1,R2,R3,R4,R5);

//open -> sys call number = 2
if(syscall == INT_OPEN) then
    //find free per process resource table entry

    alias fileName R6;
    fileName = [[PTBR + 2*((userSP - 4)/512)] * 512 + (userSP - 4) % 512];

    alias i R7;
    i=0;
    alias ind R8;
    ind = -1;
    alias resource_table R9;
    resource_table = [PROCESS_TABLE + (pid*16) + 11]*512 + RESOURCE_TABLE_OFFSET;
    
    while(i<8) do   
        if([resource_table + i*2] == -1) then 
            ind = i;
            break;
        endif;
        i = i+1;
    endwhile;

    if(ind == -1) then
        [retAddr] = -3;  //process has reached limit of RESOURCE
        goto returnCode;
    endif;

    alias openFileInd R10;


    multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9);
    R1 = OPEN; //3
    R2 = fileName;
    call FILE_MANAGER;  //MOD 3
    openFileInd = R0;
    multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9);

    if(openFileInd == -1 || openFileInd == -2) then
        [retAddr] = openFileInd; //ERROR CODE
        goto returnCode;
    endif;

    //set up resource table
    [resource_table + ind*2] = FILE;
    [resource_table + ind*2 + 1] = openFileInd;

    [retAddr] = ind;
endif;

//close -> 3
if(syscall == INT_CLOSE) then
    alias resource_ind R6;
    resource_ind = [[PTBR + 2*((userSP - 4)/512)] * 512 + (userSP - 4) % 512];

    if(resource_ind <0 || resource_ind>7) then
        [retAddr] = -1;
    else
        alias resource_table R7;
        resource_table = [PROCESS_TABLE + (pid*16) + 11]*512 + RESOURCE_TABLE_OFFSET;

        //no file is open with this index? -> return -1
        if([resource_table + resource_ind*2] != FILE) then
            [retAddr] = -1;
            goto returnCode;
        endif;

        alias openFileInd R8;
        openFileInd = [resource_table + resource_ind*2 + 1];

        multipush(R1,R2,R3,R4,R5,R6,R7,R8);
        R1 = CLOSE;
        R2 = openFileInd;
        call FILE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8);

        //invalidate resource table
        [resource_table + resource_ind*2] = -1;
        [resource_table + resource_ind*2 + 1] = -1;

        [retAddr] = 0;
    endif;
endif;

//seek -> 6
if(syscall == INT_SEEK) then
    //arg -> file Descriptor and offset
    //Return Values :
    //  0	Success
    // -1	File Descriptor given is invalid
    // -2	Offset value moves the file pointer to a position outside the file
    
    alias fd R6;
    fd = [[PTBR + 2*((userSP - 4)/512)] * 512 + (userSP - 4) % 512];
    alias offset R7;
    offset = [[PTBR + 2*((userSP - 3)/512)] * 512 + (userSP - 3) % 512];

    if(fd<0 || fd>7) then
        [retAddr] = -1;
    else
        alias resource_table R8;
        resource_table = [PROCESS_TABLE + (pid*16) + 11]*512 + RESOURCE_TABLE_OFFSET;

        //no file is open with this index? -> return -1
        if([resource_table + fd*2] != FILE) then
            [retAddr] = -1;
            goto returnCode;
        endif;

        alias openFileInd R9;
        openFileInd = [resource_table + fd*2 + 1];

        alias inodeInd R10;
        inodeInd = [OPEN_FILE_TABLE + openFileInd*4];

        //aquire lock
        multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
        R1 = ACQUIRE_INODE;
        R3 = pid;
        R2 = inodeInd;
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);

        if(R0 == -1) then
            [retAddr] = -1;
            goto returnCode;
        endif;

        alias lseek R11;
        lseek = [OPEN_FILE_TABLE + openFileInd*4 + 2];

        alias fileSize R12;
        if([OPEN_FILE_TABLE + (openFileInd*4) + 0] == INODE_ROOT) then
            fileSize = 480;
        else
            fileSize = [INODE_TABLE + inodeInd*16 + 2];
        endif;

        if(lseek + offset < 0) then
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);
            R1 = RELEASE_INODE;
            R3 = pid;
            R2 = inodeInd;
            call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);

            [retAddr] = -2;
            goto returnCode;
        endif;

        if(offset == 0) then
            [OPEN_FILE_TABLE + openFileInd*4 + 2] = 0;
        else
            if (lseek + offset > fileSize) then
                [OPEN_FILE_TABLE + openFileInd*4 + 2] = fileSize;
            else
                [OPEN_FILE_TABLE + openFileInd*4 + 2] = lseek + offset;
            endif;
        endif;
        
        multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);
        R1 = RELEASE_INODE;
        R3 = pid;
        R2 = inodeInd;
        call RESOURCE_MANAGER;
        multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11,R12);

        [retAddr] = 0;
    endif;
endif;

returnCode:
    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call ACCESS_CONTROL;
    [mode] = 0;
    SP = userSP;
    ireturn;