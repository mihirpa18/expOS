[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +9]=-1;
[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +13]=SP;
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +11]*512-1;

backup;

//push EIP
multipush(EIP);

R1 = ACQUIRE_KERN_LOCK; //1
call ACCESS_CONTROL;

//if exception cause is not page fault or user stack is full -> exit 
if(EC!=0 || [PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +13]==(PTLR*512-1)) then
    //breakpoint;
    if([PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +13]==(PTLR*512-1)) then
        print "StackOverflow";
    else
        if(EC==1) then
            print "ill_Inst";
        endif;
        if(EC==2) then
            print "ill_mem_add";
        endif;
        if(EC==3) then
            print "ill_math";
        endif;
    endif;

    //call exit process and schedule other process
    R1=3;
    R2=[SYSTEM_STATUS_TABLE + CORE*5 + 1];
    call PROCESS_MANAGER;

    R1 = RELEASE_LOCK;
    R2 = KERN_LOCK;
    call ACCESS_CONTROL;

    call SCHEDULER;
endif;

//IF PAGE FAULT IS DUE TO CODE PAGE 
if(EPN>3 && EPN<8) then

    alias reqBlock R2;
    alias pageNum R3;
    reqBlock=[DISK_MAP_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*10) +EPN];

    //call get code page
    multipush(EPN,R1,R2,R3);
    R2=reqBlock;
    R1=5;
    call MEMORY_MANAGER;
    multipop(EPN,R1,R2,R3);

    pageNum=R0;

    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + EPN*2]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + (EPN*2)+1]="1100";

endif;

//if exception is due to heap page
if(EPN==2 || EPN==3) then
    //allocate 2 heap pages 
    multipush(R1);
    R1=1;
    call MEMORY_MANAGER;
    multipop(R1);
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + 4]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + 5]="1110";

    multipush(R1);
    R1=1;
    call MEMORY_MANAGER;
    multipop(R1);
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + 6]=R0;
    [[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +14] + 7]="1110";

endif;

R1 = RELEASE_LOCK;
R2 = KERN_LOCK;
call ACCESS_CONTROL;

multipop(EIP);
restore;

[PROCESS_TABLE+ ([SYSTEM_STATUS_TABLE + CORE*5 + 1]*16) +9]=0;

SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + CORE*5 + 1] *16 ) + 13];
SP=SP+1;

[[PTBR + 2*(SP/512)]*512 + SP%512] = EIP;

ireturn;
