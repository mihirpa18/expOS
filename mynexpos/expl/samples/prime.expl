int main(){
    decl
        int i,num,temp,isprime;
    enddecl

    begin
        num=2;
        while(num<=100) do
            isprime=1;
            i=2;
            while(i<num) do
                if((num%i)==0) then
                    isprime=0;
                    break;
                endif;
                i=i+1;
            endwhile;

            if(isprime==1) then
                temp=exposcall("Write",-2,num);
            endif;
            num=num+1;
        endwhile;

        return 0;
    end
}
